# ================================================================
# True Cost Revealer — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ================================================================

# ------- Supabase -------
# Found in: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------- Admin Panel -------
# Set a strong password for the /admin panel
ADMIN_PASSWORD=change-this-to-a-strong-password

# JWT secret for admin session tokens (use a long random string)
JWT_SECRET=generate-a-64-char-random-string-here

# ------- App URL -------
# Used to generate magic links and shareable token URLs
# In production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
